# ──────────────────────────────────────────────────────────────────────────────
#  COPIE CE FICHIER EN « .env » ET METS TA CLÉ DEDANS
#
#      cp .env.exemple .env
#      puis remplace la ligne ci-dessous par ta vraie clé
#
#  « .env » est ignoré par git : il ne partira jamais au dépôt.
#  Ce fichier-ci, « .env.exemple », est versionné — il ne doit JAMAIS contenir
#  de vraie valeur, seulement le nom de la variable.
# ──────────────────────────────────────────────────────────────────────────────

# La clé DeepSeek. Elle est lue par `serve.js`, dans le processus, et ne traverse
# jamais une réponse HTTP : la page ne la voit pas.
DEEPSEEK_API_KEY=sk-remplace-moi

# Le port du serveur local. Facultatif.
# PORT=8080

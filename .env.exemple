# Copie ce fichier en `.env` et remplis ce qui te concerne.
#
#   cp .env.exemple .env
#   $EDITOR .env
#   npm start
#
# `.env` est ignoré par git ET refusé par test/secrets.test.js s'il y entrait quand même.
# Ce fichier-ci est suivi : il ne contient aucune valeur, seulement les noms.
#
# Ne colle jamais une clé ailleurs qu'ici — ni dans un message, ni dans un ticket. Une clé
# qui a été écrite quelque part de partagé est compromise, même effacée ensuite.

# ── DeepSeek — une clé, rien d'autre ──────────────────────────────────────────
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE=https://api.deepseek.com     # à changer derrière une passerelle interne

# ── Réglages ──────────────────────────────────────────────────────────────────
# PORT=8080
